# Copy to .env for local testing (never commit .env). In GitHub Actions
# these are set as repository Secrets/Variables instead -- see README.md.

# WordPress REST API (Users -> Profile -> Application Passwords in wp-admin)
WP_BASE_URL=https://staging.bizbot.com
WP_APP_USER=
WP_APP_PASSWORD=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Hostinger SFTP, for deploy_theme.yml (hPanel -> Files -> FTP Accounts)
HOSTINGER_SFTP_HOST=
HOSTINGER_SFTP_USER=
HOSTINGER_SFTP_PASSWORD=
HOSTINGER_SFTP_PORT=65002
# Repository *variables* (not secrets, they're just paths), used by deploy_theme.yml:
# HOSTINGER_THEME_REMOTE_PATH=public_html/wp-content/themes/bizbot-site
# HOSTINGER_MU_PLUGINS_REMOTE_PATH=public_html/wp-content/mu-plugins
